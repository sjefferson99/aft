FROM nginx:1.31.2-alpine3.23-slim

# Install openssl for generating self-signed certificates
RUN apk add --no-cache openssl

# Copy entrypoint script and fix line endings
# Build context must be the repo root (not ./server)
COPY server/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# Bake in nginx config and static web files so the image is self-contained.
# Both can still be overridden at runtime via volume mounts (used in local dev).
COPY server/nginx.conf /etc/nginx/conf.d/default.conf
COPY www/ /usr/share/nginx/html/

# Set entrypoint
ENTRYPOINT ["/entrypoint.sh"]
