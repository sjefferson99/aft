# =============================================================================
# Database Configuration
# =============================================================================
# Root password for the MySQL container. Not used by the app directly, but
# required by the MySQL Docker image on first run to initialise the database.
# Use a strong, unique password in production.
MYSQL_ROOT_PASSWORD=your_root_password_here

# Name of the database the application will use.
MYSQL_DATABASE=aft_db

# Credentials the application uses to connect to the database.
# Grant only the minimum required privileges to this user.
MYSQL_USER=aft_user
MYSQL_PASSWORD=your_user_password_here

# =============================================================================
# Database Memory Tuning (optional)
# =============================================================================
# MySQL settings passed to the db container by compose.yml. The defaults suit
# small self-hosted installs (idle memory ~130 MB). Uncomment and change a value
# only if you need to; full guidance for each option is in the README:
# https://github.com/sjefferson99/aft#database-memory-tuning
# Apply changes with: docker compose up -d db
#
# MYSQL_INNODB_BUFFER_POOL_SIZE
#   InnoDB data/index cache. Raise to at least your database size on large installs.
# MYSQL_MAX_CONNECTIONS
#   Connection limit. Keep above 15 x gunicorn workers plus ~10 for backups/restores.
# MYSQL_MAX_ALLOWED_PACKET
#   Largest single SQL statement. Raise if restoring a backup fails with a packet error.
# MYSQL_INNODB_LOG_BUFFER_SIZE
#   Redo log buffer. Raise only for very large bulk imports.
# MYSQL_TABLE_OPEN_CACHE
#   Open table handles cached across sessions.
# MYSQL_PERFORMANCE_SCHEMA
#   Set to ON only to diagnose MySQL performance; adds ~190 MB of memory.
#
# MYSQL_INNODB_BUFFER_POOL_SIZE=32M
# MYSQL_MAX_CONNECTIONS=100
# MYSQL_MAX_ALLOWED_PACKET=128M
# MYSQL_INNODB_LOG_BUFFER_SIZE=4M
# MYSQL_TABLE_OPEN_CACHE=200
# MYSQL_PERFORMANCE_SCHEMA=OFF

# =============================================================================
# Server Workers and Threads (optional)
# =============================================================================
# gunicorn settings for the server container. The defaults (1 worker, 32
# threads, idle memory ~110 MB) suit most self-hosted installs. Full guidance:
# https://github.com/sjefferson99/aft#server-workers-and-threads
# Apply changes with: docker compose up -d server
#
# GUNICORN_THREADS (1-128)
#   Threads per worker. Each open board tab holds one thread, so this is
#   roughly how many tabs a worker can serve. Raise this first if needed.
# GUNICORN_WORKERS (1-16)
#   Worker processes, ~80 MB each. Raise only if CPU is the bottleneck, and
#   keep MYSQL_MAX_CONNECTIONS above 15 x workers + 10.
#
# GUNICORN_THREADS=32
# GUNICORN_WORKERS=1

# =============================================================================
# Application Environment
# =============================================================================
# Controls Flask's runtime behaviour.
#
# FLASK_ENV
#   production  — Recommended for live deployments. Disables the interactive
#                 debugger and detailed error pages so internals are never
#                 exposed to end users.
#   development — Enables extra logging and developer-friendly error pages.
#                 Never use in production.
FLASK_ENV=production

# FLASK_DEBUG
#   0 — Debug mode off. Required for production. Keeps error details private
#       and disables the auto-reloader.
#   1 — Debug mode on. Enables the interactive debugger (exposes source code
#       and stack traces to anyone who sees an error page) and auto-reloads
#       the server on code changes. Development only.
FLASK_DEBUG=0

# =============================================================================
# Flask Secret Key (REQUIRED)
# =============================================================================
# Used to cryptographically sign session cookies and CSRF tokens.
# Must be a strong, random value — never a guessable string.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: The server will refuse to start if this is not set.
# Never reuse this value across environments. Rotate immediately if compromised.
SECRET_KEY=replace-with-a-generated-random-secret

# =============================================================================
# Redis Configuration
# =============================================================================
# Connection URL for the Redis instance used for server-side session storage.
# The default points to the Redis service defined in compose.yml.
# Update the hostname/port if Redis is hosted separately.
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Session Storage
# =============================================================================
# ENABLE_SERVER_SIDE_SESSIONS
#   true  — Sessions are stored in Redis (recommended for production). Requires
#           REDIS_URL to be set. Prevents session data from being read or
#           tampered with by clients.
#   false — Sessions are stored as signed cookies on the client. Simpler to
#           run (no Redis needed) but session contents are visible to the client
#           and cookie size limits apply.
ENABLE_SERVER_SIDE_SESSIONS=true

# =============================================================================
# Session Cookie Security
# =============================================================================
# SESSION_COOKIE_SECURE
#   true  — The browser will only send the session cookie over HTTPS (required
#           for production to prevent session hijacking over plain HTTP).
#   false — Cookie is also sent over plain HTTP. Only set this for controlled
#           local development when running without HTTPS.
SESSION_COOKIE_SECURE=true

# =============================================================================
# Health Check Security
# =============================================================================
# Secret token required by the internal readiness health check endpoint.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
HEALTHCHECK_TOKEN=replace-with-a-generated-random-healthcheck-token

# IP address permitted to call the internal readiness endpoint.
# The default (127.0.0.1) works for same-host Docker Compose deployments.
# Change this if your health checker runs on a different host.
HEALTHCHECK_ALLOWED_SOURCE_IP=127.0.0.1

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of origins allowed to make cross-origin requests
# (HTTP, HTTPS, and WebSocket). Only exact origins are matched — no wildcards.
#
# Production: list only your real domain(s).
#   Example: https://yourdomain.com,https://www.yourdomain.com
#
# Development: add every origin you access the app from. localhost and
#   127.0.0.1 are distinct CORS origins so both must be listed if used.
#   HTTP and HTTPS variants are also distinct.
#   Example: http://localhost,http://127.0.0.1,https://localhost,https://127.0.0.1
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# Passkeys (optional)
# =============================================================================
# Let users sign in with a passkey instead of their password. Off until
# WEBAUTHN_RP_ID is set. Read the README first: passkeys need a domain name
# (not an IP address) and HTTPS with a certificate the browser trusts, and
# changing WEBAUTHN_RP_ID later stops every existing passkey from working.
# https://github.com/sjefferson99/aft#passkeys
# Apply changes with: docker compose up -d server
#
# WEBAUTHN_RP_ID
#   Domain passkeys are tied to, with no scheme, port or path.
# WEBAUTHN_ORIGINS
#   Comma-separated addresses users open AFT at. Default: https://<WEBAUTHN_RP_ID>
#   Only http://localhost may use http (for development).
# WEBAUTHN_RP_NAME
#   Name shown by browsers and password managers. Default: AFT
#
# WEBAUTHN_RP_ID=aft.example.com
# WEBAUTHN_ORIGINS=https://aft.example.com
# WEBAUTHN_RP_NAME=AFT

# =============================================================================
# Sign-in Rate Limits
# =============================================================================
# Slows down password guessing. The defaults suit most installs. Full guidance:
# https://github.com/sjefferson99/aft#sign-in-rate-limits
# Apply changes with: docker compose up -d server
#
# TRUSTED_PROXY_HOPS
#   Proxies in front of the server, including the bundled nginx. Set this to 2
#   if another reverse proxy (such as Traefik) sits in front of nginx, or all
#   users will count as one client. It must match your setup exactly: too high
#   lets clients fake their IP address.
# AUTH_RATE_LIMIT_ACCOUNT_FAILURES
#   Failed password attempts allowed per account in 15 minutes.
# AUTH_RATE_LIMIT_IP_FAILURES
#   Failed password attempts allowed per client IP in 15 minutes.
# AUTH_RATE_LIMIT_REGISTRATIONS
#   Registration attempts allowed per client IP in an hour.
# AUTH_RATE_LIMIT_PASSKEY_STARTS
#   Passkey sign-ins allowed to start per client IP in a minute.
#
# TRUSTED_PROXY_HOPS=1
# AUTH_RATE_LIMIT_ACCOUNT_FAILURES=10
# AUTH_RATE_LIMIT_IP_FAILURES=50
# AUTH_RATE_LIMIT_REGISTRATIONS=10
# AUTH_RATE_LIMIT_PASSKEY_STARTS=60

# =============================================================================
# Public Board Embed Configuration
# =============================================================================
# Comma-separated list of external origins allowed to embed public boards via
# iframe. This is intended for nginx frame-ancestor policy generation.
#
# Use exact origins (scheme + host [+ port]) and optional controlled wildcard
# subdomain patterns (scheme + *.domain [+ port]).
# Examples:
#   https://partner-a.example,https://portal.partner-b.example
#   https://partner.example,https://*.partner.example
#
# Note: wildcard patterns do not include the apex domain. Include both if needed.
#
# Keep this list minimal and only include trusted partner sites.
EMBED_ALLOWED_ORIGINS=

# =============================================================================
# WebSocket Testing (Development / QA Only)
# =============================================================================
# REJECT_SOCKETIO_CONNECTIONS
#   true  — The server actively rejects all WebSocket connections. Useful for
#           testing that the frontend handles disconnection gracefully.
#           WARNING: NEVER set to true in production — it will break real-time
#           features for all users.
#   false — Normal operation. WebSocket connections are accepted (default).
REJECT_SOCKETIO_CONNECTIONS=false