# Raspberry Pi Zero 2 W settings for AFT's .env. Start from .env.example and
# change these values; everything else stays as in .env.example.

# MySQL. 32M is already the default buffer pool and holds a typical AFT
# database. The connection limit must be at least 15 per gunicorn worker plus
# 10 for backups and restores, or the server logs a warning at startup.
MYSQL_INNODB_BUFFER_POOL_SIZE=32M
MYSQL_MAX_CONNECTIONS=30
MYSQL_PERFORMANCE_SCHEMA=OFF

# gunicorn. One worker. Each open AFT tab holds a thread for as long as it
# stays open, and once every thread is held, all requests hang. Measured on a
# Pi Zero 2 W: 8 threads served 7 open tabs and hung on the 8th, and holding
# them open cost about 2 MB more than 2 threads. Don't go lower than 8.
GUNICORN_WORKERS=1
GUNICORN_THREADS=8

# Add every name clients use in the browser, for example the Pi's hostname.
CORS_ALLOWED_ORIGINS=https://aft-portable,https://192.168.1.50
