# Settings for aft-inky-status, installed to /etc/default/aft-inky-status.
# Apply changes with: sudo systemctl restart aft-inky-status

# Seconds between checks while AFT is healthy, and while it isn't.
AFT_INKY_POLL=30
AFT_INKY_UNHEALTHY_POLL=10

# The screen redraws when anything shown changes, but at most once in this
# many seconds (minimum 30), because each refresh flashes the panel for about
# 13 seconds. A change to the URL or AFT health redraws at once.
AFT_INKY_MIN_REDRAW=60

# Set to 1 to turn the picture upside down.
AFT_INKY_FLIP=0

# Connection URL shown at the top. The host defaults to this machine's
# hostname, in lower case. Set AFT_URL_HOST to a name your clients resolve,
# such as a full DNS name, and keep it in CORS_ALLOWED_ORIGINS in AFT's .env.
# The IP address is shown at the bottom for clients that can't resolve it.
AFT_URL_SCHEME=https
#AFT_URL_HOST=aft-portable.example.lan

# Container names from compose.yml, and the health URL served by nginx.
AFT_CONTAINERS="aft-db aft-redis aft-server aft-web"
AFT_DB_CONTAINER=aft-db
AFT_HEALTH_URL=http://127.0.0.1/api/health/live

# Seconds before a docker or HTTP check counts as failed.
AFT_QUERY_TIMEOUT=20
