# Settings for aft-wifi-fallback, installed to /etc/default/aft-wifi-fallback.
# Only root can read this file, because it holds the hotspot password.
# Apply changes with: sudo systemctl restart aft-wifi-fallback

# auto:   start the hotspot when no saved Wi-Fi network is in range (default)
# always: keep the hotspot up and never join a saved network
# off:    never start the hotspot
# Change it with "sudo aft-hotspot auto|always|off", which also restarts the
# service.
AFT_HOTSPOT_MODE=auto

# The hotspot's network name (1 to 32 letters, digits, spaces, '.', '_' or
# '-') and its WPA2 password (8 to 63 characters). The installer made up this
# password for this Pi. There's no way to run an open network.
AFT_HOTSPOT_SSID=@SSID@
AFT_HOTSPOT_PASSWORD=@PASSWORD@

# 2.4 GHz channel, 1 to 13. Use one your Wi-Fi country allows.
AFT_HOTSPOT_CHANNEL=6

# Seconds without a saved network before the hotspot starts, both after boot
# and after losing a network.
AFT_HOTSPOT_START_WAIT=60

# While the hotspot is up and no clients are connected, take it down every
# this many seconds (minimum 60) to look for a saved network. Each look takes
# the hotspot down for about 10 seconds, or longer if a saved network in range
# fails to connect. 0 never looks.
AFT_HOTSPOT_RESCAN=300

# Seconds to wait for each saved network to connect during a look.
AFT_HOTSPOT_CONNECT_WAIT=30

# The Wi-Fi interface.
AFT_HOTSPOT_INTERFACE=wlan0
